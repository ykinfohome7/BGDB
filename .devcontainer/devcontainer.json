{
  "name": "BGDB Debian 13 Trixie",
  "image": "mcr.microsoft.com/devcontainers/base:trixie",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {},
    "ghcr.io/tailscale/codespace/tailscale": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "postStartCommand": "bash /workspaces/BGDB/.devcontainer/restore-codespace.sh",
  "runArgs": [
    "--device=/dev/net/tun"
  ],
  "remoteUser": "vscode",
  "mounts": [
    "source=bgdb-claude-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=bgdb-codex-config-${devcontainerId},target=/home/vscode/.codex,type=volume",
    "source=bgdb-tailscale-state-${devcontainerId},target=/var/lib/tailscale,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt"
      ]
    }
  },
  "postCreateCommand": "sudo -n bash /workspaces/BGDB/.devcontainer/install-debian-deps.sh",
  "forwardPorts": [
    8765
  ],
  "portsAttributes": {
    "8765": {
      "label": "BGSSH MCP (private)",
      "onAutoForward": "notify",
      "protocol": "http"
    }
  }
}
